WOOCOMMERCE_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=

NEXT_PUBLIC_GOOGLE_CLIENT_ID=
SESSION_SECRET=

# Brevo (formerly Sendinblue) — used to email the Contact Us form to the
# admin inbox and store the enquirer as a Brevo contact. Get the API key
# from Brevo → Settings → SMTP & API → API Keys. BREVO_SENDER_EMAIL must be
# a sender verified in that Brevo account (Settings → Senders); falls back
# to ganeshbakery1964@gmail.com if unset. Left blank, the contact form still
# works but skips the email/CRM step.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# WordPress Application Password — lets the site save Contact/Bulk Order
# form submissions as a private "Enquiry" record in wp-admin (see
# wordpress-plugin/ganesh-bakery-enquiries.php, install that plugin first).
# Generate at wp-admin → Users → your profile → Application Passwords.
# WORDPRESS_APP_USERNAME is that WP user's login name. Left blank, the
# contact form still works but skips saving to WordPress.
WORDPRESS_APP_USERNAME=
WORDPRESS_APP_PASSWORD=
